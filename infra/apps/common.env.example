# Copy to common.env. Each persistent service receives only its own DB_PASSWORD
# through Compose interpolation from .env; do not put schema passwords here.
SPRING_PROFILES_ACTIVE=aws
ENTRA_ISSUER_URI=https://login.microsoftonline.com/REPLACE_TENANT_ID/v2.0
ENTRA_AUDIENCE=REPLACE_EXACT_API_AUD
CORS_ORIGINS=http://localhost:5173
DB_URL=jdbc:oracle:thin:@//RDS_PRIVATE_ENDPOINT:1521/P360
RABBIT_ADDRESSES=MQ_PRIVATE_IP:5672
RABBIT_USER=pedidos360
RABBIT_PASSWORD=REPLACE_RABBIT_PASSWORD
RABBIT_MANAGEMENT_URL=http://MQ_PRIVATE_IP:15672
KAFKA_BOOTSTRAP_SERVERS=KAFKA_PRIVATE_IP:9092
CATALOG_URL=http://catalog:8082
ORDERS_URL=http://orders:8083
AUDIT_URL=http://audit:8084
REPORT_URL=http://report:8085
RABBIT_ADMIN_URL=http://rabbit-admin:8087
KAFKA_ADMIN_URL=http://kafka-admin:8088
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_AUTH=false
SMTP_TLS=false
NOTIFY_DIR=/app/data/notify
