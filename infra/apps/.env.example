IMAGE_REPOSITORY=ACCOUNT.dkr.ecr.REGION.amazonaws.com/pedidos360
IMAGE_TAG=1.0.0
SPRING_PROFILES_ACTIVE=aws
ENTRA_ISSUER_URI=https://login.microsoftonline.com/REPLACE_TENANT_ID/v2.0
ENTRA_AUDIENCE=REPLACE_API_CLIENT_ID
CORS_ORIGINS=http://localhost:5173
DB_URL=jdbc:oracle:thin:@//RDS_PRIVATE_ENDPOINT:1521/P360
# Use a separate schema/user for catalog, orders, audit and report.
DB_USER=P360_ORDERS
DB_PASSWORD=REPLACE_SCHEMA_PASSWORD
RABBIT_ADDRESSES=MQ_PRIVATE_IP:5672,MQ_PRIVATE_IP:5673
RABBIT_USER=pedidos360
RABBIT_PASSWORD=REPLACE_RABBIT_PASSWORD
RABBIT_MANAGEMENT_URL=http://MQ_PRIVATE_IP:15672
KAFKA_BOOTSTRAP_SERVERS=KAFKA_PRIVATE_IP:9092,KAFKA_PRIVATE_IP:9093,KAFKA_PRIVATE_IP:9094
CATALOG_URL=http://CATALOG_PRIVATE_IP:8082
ORDERS_URL=http://ORDERS_PRIVATE_IP:8083
AUDIT_URL=http://AUDIT_PRIVATE_IP:8084
REPORT_URL=http://REPORT_PRIVATE_IP:8085
RABBIT_ADMIN_URL=http://RABBIT_ADMIN_PRIVATE_IP:8087
KAFKA_ADMIN_URL=http://KAFKA_ADMIN_PRIVATE_IP:8088
SMTP_HOST=YOUR_SMTP_PROVIDER
SMTP_PORT=587
SMTP_USER=REPLACE_SMTP_USER
SMTP_PASSWORD=REPLACE_SMTP_PASSWORD
SMTP_AUTH=true
SMTP_TLS=true
MAIL_FROM=verified-sender@example.com
NOTIFY_DIR=/app/data/notify
OPENAPI_ENABLED=true
